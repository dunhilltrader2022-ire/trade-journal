# Copy this file to .env and fill in what you need. Restart the cockpit after changing it:
#   docker compose up -d

# Claude for trade reviews, the pre-trade coach and journal chat.
# Create a key at https://platform.claude.com (billed per use, separate from Claude Pro).
ANTHROPIC_API_KEY=

# Password for the browser login (any username works). Required for access over your home network.
# Use letters, numbers and hyphens only.
COCKPIT_PASSWORD=

# Telegram alerts (free). Create a bot with @BotFather, and treat its token like a password.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which alerts to send: risk, trade, setup, signal. RSI signals are left out by default because they're frequent.
# TELEGRAM_LANES=risk,trade,setup

# Monthly spending cap for Claude, in US dollars. Requests stop when it's reached.
AI_MONTHLY_CAP_USD=10

# Default price source the first time the cockpit starts: binance, kraken or simulated.
# You can change it any time on the Data feed page.
PRICE_SOURCE=binance

# Optional: override which Claude model each feature uses.
# CLAUDE_MODEL_QUICK=claude-haiku-5-5
# CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5
# CLAUDE_MODEL_COMPLEX=claude-opus-5-5
